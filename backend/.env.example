# Port serwera backendu
PORT=3000

# Sekret do podpisywania tokenów JWT oraz czas ich ważności
JWT_SECRET=zmien-mnie-na-losowy-sekret
JWT_EXPIRES_IN=7d

# Połączenie z bazą danych MySQL / MariaDB
DATABASE_URL=mysql://app:app@localhost:3306/team_task_manager
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=team_task_manager
